/*
  Behavior Definition for ZCE_SCORT_TR_TREE
  Root Custom Entity: TR Request/Task/Object Hierarchy Tree
  Mode: Read-Only (Custom Entity — query provider pattern)
  No lock master for Custom Entity (not needed — virtual data)
*/
unmanaged implementation in class zbp_ce_scort_tr_tree unique;

define behavior for ZCE_SCORT_TR_TREE alias TrTree
{
  /* Custom Entity — read-only, no standard CRUD */
  field ( readonly )
    NodeId,
    ParentNodeId,
    TreeLevel,
    NodeType,
    Trkorr,
    ParentTrkorr,
    Description,
    Owner,
    As4date,
    TrStatus,
    ObjName,
    ObjType,
    Pgmid;

  /* REQ2 Actions */
  action ( features : instance ) ReleaseRequest result [1] $self;
  action ( features : instance ) ApplyToTarget result [1] $self;
}
