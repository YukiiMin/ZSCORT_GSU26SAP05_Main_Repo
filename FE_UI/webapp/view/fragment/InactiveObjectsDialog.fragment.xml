<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    id="idInactiveObjectsDialog"
    title="{inactiveModel>/dialogTitle}"
    icon="sap-icon://alert"
    state="Error"
    contentWidth="52rem"
    contentHeight="32rem"
    resizable="true"
    draggable="true">

    <content>
      <VBox class="sapUiSmallMargin">
        <MessageStrip
          text="{inactiveModel>/description}"
          type="Error"
          showIcon="true"
          class="sapUiSmallMarginBottom" />

        <Table
          id="tblInactiveObjects"
          items="{inactiveModel>/objects}"
          inset="false"
          noDataText="{i18n>noInactiveObjects}"
          mode="None">
          <columns>
            <Column width="5.5rem">
              <Text text="{i18n>colInactiveType}" />
            </Column>
            <Column width="15rem">
              <Text text="{i18n>colInactiveName}" />
            </Column>
            <Column width="8.5rem">
              <Text text="{i18n>colInactiveTask}" />
            </Column>
            <Column width="8.5rem">
              <Text text="{i18n>colInactiveUser}" />
            </Column>
            <Column width="5.5rem" hAlign="Center">
              <Text text="{i18n>colInactiveAction}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <HBox alignItems="Center">
                  <core:Icon src="sap-icon://document-text" size="0.9rem" class="sapUiTinyMarginEnd" />
                  <ObjectIdentifier title="{inactiveModel>ObjectType}" />
                </HBox>
                <Link
                  text="{inactiveModel>ObjectName}"
                  press=".onInactiveObjectNamePress"
                  tooltip="{i18n>btnFindInObjSearch}" />
                <Text text="{inactiveModel>Trkorr}" />
                <Text text="{inactiveModel>Uname}" />
                <Button
                  icon="sap-icon://hint"
                  type="Transparent"
                  tooltip="{i18n>btnViewObjectDetails}"
                  press=".onShowInactiveObjectDetails" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>

    <buttons>
      <Button
        id="btnViewOverallError"
        text="{i18n>btnViewOverallError}"
        icon="sap-icon://message-information"
        press=".onShowOverallErrorDetails" />
      <Button
        id="btnCopyInactiveList"
        text="{i18n>btnCopyInactiveList}"
        icon="sap-icon://copy"
        press=".onCopyInactiveObjects" />
      <Button
        id="btnCloseInactiveDialog"
        text="{i18n>btnClose}"
        type="Emphasized"
        press=".onCloseInactiveObjectsDialog" />
    </buttons>

  </Dialog>
</core:FragmentDefinition>
