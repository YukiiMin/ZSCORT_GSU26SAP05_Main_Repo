<mvc:View
  controllerName="zscort.app.controller.ObjSearch"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:table="sap.ui.table"
  xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  xmlns:core="sap.ui.core">

  <Page id="idObjSearchPage" showHeader="true" backgroundDesign="List" enableScrolling="false">

    <customHeader>
      <Bar>
        <contentLeft>
          <Title text="{i18n>objSearchTitle}" />
        </contentLeft>
        <contentMiddle>
          <SegmentedButton
            selectedKey="{appView>/currentModule}"
            selectionChange=".onSegmentedButtonModuleSwitchSelectionChange">
            <items>
              <SegmentedButtonItem key="objSearch" text="{i18n>navObjSearch}" icon="sap-icon://search" />
              <SegmentedButtonItem key="trSearch"  text="{i18n>navTrSearch}"     icon="sap-icon://org-chart" />
            </items>
          </SegmentedButton>
        </contentMiddle>
        <contentRight>
          <MenuButton
            icon="sap-icon://world"
            text="{= (${appView>/currentLanguage} || 'en').toUpperCase() }"
            tooltip="Language / Ngôn ngữ"
            class="sapUiTinyMarginEnd">
            <menu>
              <Menu itemSelected=".onLanguageMenuSelect">
                <items>
                  <MenuItem key="en" text="🇬🇧 English" />
                  <MenuItem key="vi" text="🇻🇳 Tiếng Việt" />
                  <MenuItem key="ja" text="🇯🇵 日本語" />
                  <MenuItem key="zh" text="🇨🇳 中文" />
                  <MenuItem key="de" text="🇩🇪 Deutsch" />
                </items>
              </Menu>
            </menu>
          </MenuButton>
          <Button icon="sap-icon://home" type="Transparent" press=".onButtonNavObjSearchPress" tooltip="Home" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <VBox height="100%" fitContainer="true">

        <Panel headerText="{i18n>searchFilterPanel}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <content>
            <HBox class="scortFilterBox sapUiTinyMargin">

              <!-- Object Name -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>objNameLabel}" />
                <Input id="idFilterObjNameInput"
                  value="{objSearch>/filterObjName}"
                  placeholder="ZSCORT*"
                  submit=".onFilterObjNameInputSubmit" />
              </VBox>

              <!-- Object Type (multi-select) -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>objTypeLabel}" />
                <MultiComboBox id="idFilterObjTypeMultiComboBox"
                  placeholder="{i18n>allTypes}"
                  selectedKeys="{objSearch>/filterObjTypes}">
                  <items>
                    <core:Item key="PROG"  text="PROG — Program / Report" />
                    <core:Item key="CLAS"  text="CLAS — Class" />
                    <core:Item key="INTF"  text="INTF — Interface" />
                    <core:Item key="FUGR"  text="FUGR — Function Group" />
                    <core:Item key="FUNC"  text="FUNC — Function Module" />
                    <core:Item key="DDLS"  text="DDLS — CDS View Entity" />
                    <core:Item key="BDEF"  text="BDEF — Behavior Definition" />
                    <core:Item key="DCLS"  text="DCLS — Access Control (CDS Role)" />
                    <core:Item key="DDLX"  text="DDLX — Metadata Extension" />
                    <core:Item key="SRVD"  text="SRVD — Service Definition" />
                    <core:Item key="TABL"  text="TABL — Database Table / Structure" />
                    <core:Item key="DTEL"  text="DTEL — Data Element" />
                    <core:Item key="DOMA"  text="DOMA — Domain" />
                    <core:Item key="TTYP"  text="TTYP — Table Type" />
                    <core:Item key="VIEW"  text="VIEW — Database View" />
                    <core:Item key="MSAG"  text="MSAG — Message Class" />
                    <core:Item key="DEVC"  text="DEVC — Package" />
                    <core:Item key="TRAN"  text="TRAN — Transaction Code" />
                    <core:Item key="NROB"  text="NROB — Number Range Object" />
                    <core:Item key="WAPA"  text="WAPA — BSP / Web Dynpro Application" />
                    <core:Item key="SSFO"  text="SSFO — Smart Form" />
                    <core:Item key="SHLP"  text="SHLP — Search Help" />
                  </items>
                </MultiComboBox>
              </VBox>

              <!-- Package -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>packageLabel}" />
                <Input id="idFilterPackageInput"
                  value="{objSearch>/filterPackage}"
                  placeholder="ZSCORT*"
                  submit=".onFilterPackageInputSubmit" />
              </VBox>

              <!-- Person Responsible -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>authorLabel}" />
                <Input id="idFilterAuthorInput"
                  value="{objSearch>/filterAuthor}"
                  placeholder="USER*"
                  submit=".onFilterAuthorInputSubmit" />
              </VBox>

              <!-- Search Buttons -->
              <VBox class="scortFilterButtons" justifyContent="End">
                <HBox wrap="Wrap" class="scortFilterButtons">
                  <Button id="idSearchButton"
                    text="{i18n>searchBtn}"
                    type="Emphasized"
                    icon="sap-icon://search"
                    press=".onSearchButtonPress"
                    class="sapUiTinyMarginEnd" />
                  <Button id="idClearButton"
                    text="{i18n>clearBtn}"
                    type="Transparent"
                    press=".onClearButtonPress" />
                </HBox>
              </VBox>

            </HBox>
          </content>
        </Panel>

        <IconTabBar
          id="idModeIconTabBar"
          selectedKey="{objSearch>/activeTab}"
          select=".onIconTabBarModeSelect"
          expandable="false"
          stretchContentHeight="true"
          class="sapUiNoContentPadding">
          <layoutData>
            <FlexItemData growFactor="1" />
          </layoutData>

          <!-- TAB 1: Local Objects (from TADIR) -->
          <items>
            <IconTabFilter
              key="local"
              text="{i18n>tabLocal}"
              icon="sap-icon://database"
              count="{objSearch>/countLocal}">
              <content>
                <VBox height="100%" fitContainer="true">
                  <OverflowToolbar>
                    <Title text="{i18n>objectsLocalTitle}" />
                    <ToolbarSpacer />
                    <BusyIndicator size="1rem" visible="{objSearch>/loadingMoreLocal}" class="sapUiTinyMarginEnd" />
                    <Label text="{= ${objSearch>/countLocal} + ' object(s)'}" class="sapUiTinyMarginEnd" />
                    <Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onButtonExportLocalPress" />
                  </OverflowToolbar>
                  <table:Table id="idLocalTable"
                    busy="{objSearch>/busyLocal}"
                    noData="{i18n>enterSearchCriteria}"
                    selectionMode="Single"
                    rowSelectionChange=".onTableLocalSelectionChange"
                    firstVisibleRowChanged=".onLocalTableScroll"
                    threshold="50"
                    alternateRowColors="true"
                    enableColumnReordering="true"
                    enableGrouping="true"
                    showColumnVisibilityMenu="true"
                    visibleRowCountMode="Auto"
                    minAutoRowCount="5"
                    rows="{path: 'objSearch>/localRows'}">
                    <table:layoutData>
                      <FlexItemData growFactor="1" />
                    </table:layoutData>
                    <table:columns>
                      <table:Column width="6rem" filterProperty="ObjectType" sortProperty="ObjectType">
                        <Label text="{i18n>colType}" />
                        <table:template>
                          <ObjectStatus text="{objSearch>ObjectType}" state="None" />
                        </table:template>
                      </table:Column>
                      <table:Column width="20rem" filterProperty="ObjectName" sortProperty="ObjectName">
                        <Label text="{i18n>colObjName}" />
                        <table:template>
                          <ObjectIdentifier title="{objSearch>ObjectName}" titleActive="true" titlePress=".onObjectIdentifierObjNameTitlePress" />
                        </table:template>
                      </table:Column>
                      <table:Column width="15rem" filterProperty="PackageName" sortProperty="PackageName">
                        <Label text="{i18n>colPackage}" />
                        <table:template>
                          <Text text="{objSearch>PackageName}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="10rem" filterProperty="PersonResponsible" sortProperty="PersonResponsible">
                        <Label text="{i18n>colPersonResp}" />
                        <table:template>
                          <Text text="{objSearch>PersonResponsible}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="10rem" filterProperty="CreatedOn" sortProperty="CreatedOn">
                        <Label text="{i18n>colCreated}" />
                        <table:template>
                          <Text text="{path: 'objSearch>CreatedOn', formatter: '.formatDate'}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="12rem">
                        <Label text="{i18n>colActions}" />
                        <table:template>
                          <HBox>
                            <Button text="{i18n>btnCompare}" icon="sap-icon://compare-2" tooltip="{i18n>openCompareTooltip}" press=".onButtonOpenComparePress" class="sapUiTinyMarginEnd" />
                            <Button icon="sap-icon://document-text" tooltip="{i18n>viewSourceTooltip}" type="Transparent" press=".onButtonViewSourcePress" />
                            <Button icon="sap-icon://shipping-status" tooltip="{i18n>btnFindAssignedTr}" type="Transparent" press=".onButtonFindAssignedTrPress" />
                          </HBox>
                        </table:template>
                      </table:Column>
                    </table:columns>
                  </table:Table>
                </VBox>
              </content>
            </IconTabFilter>

            <!-- TAB 2: Target Objects (from ZA_SCORT_T_SRC) -->
            <IconTabFilter
              key="target"
              text="{i18n>tabTarget}"
              icon="sap-icon://upload-to-cloud"
              count="{objSearch>/countTarget}">
              <content>
                <VBox height="100%" fitContainer="true">
                  <OverflowToolbar>
                    <Title text="{i18n>objectsTargetTitle}" />
                    <ToolbarSpacer />
                    <BusyIndicator size="1rem" visible="{objSearch>/loadingMoreTarget}" class="sapUiTinyMarginEnd" />
                    <Label text="{= ${objSearch>/countTarget} + ' object(s)'}" class="sapUiTinyMarginEnd" />
                    <Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onButtonExportTargetPress" />
                  </OverflowToolbar>
                  <table:Table id="idTargetTable"
                    busy="{objSearch>/busyTarget}"
                    noData="{i18n>enterSearchCriteria}"
                    selectionMode="Single"
                    rowSelectionChange=".onTableTargetSelectionChange"
                    firstVisibleRowChanged=".onTargetTableScroll"
                    threshold="50"
                    alternateRowColors="true"
                    enableColumnReordering="true"
                    enableGrouping="true"
                    showColumnVisibilityMenu="true"
                    visibleRowCountMode="Auto"
                    minAutoRowCount="5"
                    rows="{path: 'objSearch>/targetRows'}">
                    <table:layoutData>
                      <FlexItemData growFactor="1" />
                    </table:layoutData>
                    <table:columns>
                      <table:Column width="6rem" filterProperty="ObjectType" sortProperty="ObjectType">
                        <Label text="{i18n>colType}" />
                        <table:template>
                          <ObjectStatus text="{objSearch>ObjectType}" state="None" />
                        </table:template>
                      </table:Column>
                      <table:Column width="20rem" filterProperty="ObjectName" sortProperty="ObjectName">
                        <Label text="{i18n>colObjName}" />
                        <table:template>
                          <ObjectIdentifier title="{objSearch>ObjectName}" titleActive="true" titlePress=".onObjectIdentifierObjNameTitlePress" />
                        </table:template>
                      </table:Column>
                      <table:Column width="15rem" filterProperty="PackageName" sortProperty="PackageName">
                        <Label text="{i18n>colPackage}" />
                        <table:template>
                          <Text text="{objSearch>PackageName}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="10rem" filterProperty="PersonResponsible" sortProperty="PersonResponsible">
                        <Label text="{i18n>colPersonResp}" />
                        <table:template>
                          <Text text="{objSearch>PersonResponsible}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="10rem" filterProperty="CreatedOn" sortProperty="CreatedOn">
                        <Label text="{i18n>colCreated}" />
                        <table:template>
                          <Text text="{path:'objSearch>CreatedOn', formatter:'.formatDate'}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="12rem">
                        <Label text="{i18n>colActions}" />
                        <table:template>
                          <HBox>
                            <Button text="{i18n>btnCompare}"
                              icon="sap-icon://compare-2"
                              tooltip="{i18n>openCompareTooltip}"
                              press=".onButtonOpenComparePress"
                              class="sapUiTinyMarginEnd" />
                            <Button icon="sap-icon://document-text"
                              tooltip="{i18n>viewSourceTooltip}"
                              type="Transparent"
                              press=".onButtonViewSourcePress" />
                            <Button icon="sap-icon://shipping-status"
                              tooltip="{i18n>btnFindAssignedTr}"
                              type="Transparent"
                              press=".onButtonFindAssignedTrPress" />
                          </HBox>
                        </table:template>
                      </table:Column>
                    </table:columns>
                  </table:Table>
                </VBox>
              </content>
            </IconTabFilter>

            <!-- TAB 3: Compare Matrix (BOTH / LOCAL_ONLY / TARGET_ONLY) -->
            <IconTabFilter
              key="matrix"
              text="{i18n>tabMatrix}"
              icon="sap-icon://split"
              count="{objSearch>/countMatrix}">
              <content>
                <VBox height="100%" fitContainer="true">
                  <OverflowToolbar>
                    <Title text="{i18n>objectsMatrixTitle}" />
                    <ToolbarSpacer />
                    <Label text="{i18n>lblViewCodeAsServer}:" class="sapUiTinyMarginEnd" />
                    <SegmentedButton
                      selectedKey="{objSearch>/matrixServerType}"
                      selectionChange=".onSegmentedButtonMatrixServerSwitchSelectionChange">
                      <items>
                        <SegmentedButtonItem key="L" text="{i18n>lblServerLocal}" />
                        <SegmentedButtonItem key="T" text="{i18n>lblServerTarget}" />
                      </items>
                    </SegmentedButton>
                    <ToolbarSeparator />
                    <SegmentedButton
                      selectedKey="{objSearch>/matrixFilter}"
                      selectionChange=".onSegmentedButtonMatrixFilterSelectionChange">
                      <items>
                        <SegmentedButtonItem key="" text="{i18n>filterAll}" />
                        <SegmentedButtonItem key="BOTH" text="{i18n>existenceStatusBoth}" />
                        <SegmentedButtonItem key="LOCAL_ONLY" text="{i18n>existenceStatusLocalOnly}" />
                        <SegmentedButtonItem key="TARGET_ONLY" text="{i18n>existenceStatusTargetOnly}" />
                      </items>
                    </SegmentedButton>
                    <Button icon="sap-icon://refresh" tooltip="Reload" press=".onButtonSearchMatrixPress" type="Transparent" />
                  </OverflowToolbar>
                  <table:Table id="idMatrixTable"
                    busy="{objSearch>/busyMatrix}"
                    noData="{i18n>enterSearchCriteria}"
                    selectionMode="Single"
                    alternateRowColors="true"
                    enableColumnReordering="true"
                    enableGrouping="true"
                    showColumnVisibilityMenu="true"
                    visibleRowCountMode="Auto"
                    minAutoRowCount="5"
                    rows="{path: 'objSearch>/matrixRows'}">
                    <table:layoutData>
                      <FlexItemData growFactor="1" />
                    </table:layoutData>
                    <table:columns>
                      <table:Column width="6rem" filterProperty="ObjectType" sortProperty="ObjectType">
                        <Label text="{i18n>colType}" />
                        <table:template>
                          <ObjectStatus text="{objSearch>ObjectType}" state="None" />
                        </table:template>
                      </table:Column>
                      <table:Column width="20rem" filterProperty="ObjectName" sortProperty="ObjectName">
                        <Label text="{i18n>colObjName}" />
                        <table:template>
                          <ObjectIdentifier title="{objSearch>ObjectName}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="8rem" filterProperty="ExistenceStatus" sortProperty="ExistenceStatus">
                        <Label text="{i18n>colStatus}" />
                        <table:template>
                          <ObjectStatus
                            text="{objSearch>ExistenceStatus}"
                            state="{path:'objSearch>ExistenceStatus', formatter:'.formatExistenceState'}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="11rem" filterProperty="LocalPackage" sortProperty="LocalPackage">
                        <Label text="{i18n>colLocalPackage}" />
                        <table:template>
                          <Text text="{objSearch>LocalPackage}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="11rem" filterProperty="TargetPackage" sortProperty="TargetPackage">
                        <Label text="{i18n>colTargetPackage}" />
                        <table:template>
                          <Text text="{objSearch>TargetPackage}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="8.5rem" filterProperty="LocalAuthor" sortProperty="LocalAuthor">
                        <Label text="{i18n>colLocalAuthor}" />
                        <table:template>
                          <Text text="{objSearch>LocalAuthor}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="8.5rem" filterProperty="TargetAuthor" sortProperty="TargetAuthor">
                        <Label text="{i18n>colTargetAuthor}" />
                        <table:template>
                          <Text text="{objSearch>TargetAuthor}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="12rem">
                        <Label text="{i18n>colActions}" />
                        <table:template>
                          <HBox>
                            <Button text="{i18n>btnCompare}"
                              icon="sap-icon://compare-2"
                              tooltip="{i18n>openCompareTooltip}"
                              visible="{= ${objSearch>ExistenceStatus} === 'BOTH' }"
                              press=".onButtonOpenComparePress"
                              class="sapUiTinyMarginEnd" />
                            <Button icon="sap-icon://document-text"
                              tooltip="{i18n>viewSourceTooltip}"
                              type="Transparent"
                              press=".onButtonViewSourcePress" />
                            <Button icon="sap-icon://shipping-status"
                              tooltip="{i18n>btnFindAssignedTr}"
                              type="Transparent"
                              press=".onButtonFindAssignedTrPress" />
                          </HBox>
                        </table:template>
                      </table:Column>
                    </table:columns>
                  </table:Table>
                </VBox>
              </content>
            </IconTabFilter>
          </items>
        </IconTabBar>

      </VBox>
    </content>
  </Page>

</mvc:View>
