<mvc:View
  controllerName="zscort.app.controller.ObjSearch"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:table="sap.ui.table"
  xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  xmlns:core="sap.ui.core">

  <Page id="idObjSearchPage" showHeader="true" backgroundDesign="List" enableScrolling="false">

    <customHeader>
      <Bar>
        <contentLeft>
          <Title text="SCORT — Object Search" />
        </contentLeft>
        <contentMiddle>
          <SegmentedButton
            selectedKey="{appView>/currentModule}"
            selectionChange=".onSegmentedButtonModuleSwitchSelectionChange">
            <items>
              <SegmentedButtonItem key="objSearch" text="Object Search" icon="sap-icon://search" />
              <SegmentedButtonItem key="trSearch"  text="TR Search"     icon="sap-icon://org-chart" />
              <SegmentedButtonItem key="compare"   text="Code Compare"  icon="sap-icon://compare-2" />
            </items>
          </SegmentedButton>
        </contentMiddle>
        <contentRight>
          <Button icon="sap-icon://home" type="Transparent" press=".onButtonNavObjSearchPress" tooltip="Home" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <VBox height="100%" fitContainer="true">

        <Panel headerText="Search &amp; Filter" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <content>
            <HBox alignItems="End" wrap="Wrap" class="sapUiTinyMargin">

              <!-- Object Name -->
              <VBox class="sapUiTinyMarginEnd">
                <Label text="Object Name (Wildcard)" />
                <Input id="idFilterObjNameInput"
                  width="14rem"
                  value="{objSearch>/filterObjName}"
                  placeholder="ZSCORT*"
                  submit=".onFilterObjNameInputSubmit" />
              </VBox>

              <!-- Object Type (multi-select) -->
              <VBox class="sapUiTinyMarginEnd">
                <Label text="Object Type" />
                <MultiComboBox id="idFilterObjTypeMultiComboBox"
                  width="14rem"
                  placeholder="All types"
                  selectedKeys="{objSearch>/filterObjTypes}">
                  <items>
                    <core:Item key="PROG"  text="PROG — Program/Report" />
                    <core:Item key="CLAS"  text="CLAS — Class" />
                    <core:Item key="INTF"  text="INTF — Interface" />
                    <core:Item key="FUGR"  text="FUGR — Function Group" />
                    <core:Item key="FUNC"  text="FUNC — Function Module" />
                    <core:Item key="TABL"  text="TABL — Database Table" />
                    <core:Item key="DTEL"  text="DTEL — Data Element" />
                    <core:Item key="DOMA"  text="DOMA — Domain" />
                    <core:Item key="DDLS"  text="DDLS — CDS View" />
                    <core:Item key="BDEF"  text="BDEF — Behavior Definition" />
                    <core:Item key="TRAN"  text="TRAN — Transaction" />
                    <core:Item key="DEVC"  text="DEVC — Package" />
                  </items>
                </MultiComboBox>
              </VBox>

              <!-- Package -->
              <VBox class="sapUiTinyMarginEnd">
                <Label text="Package (Wildcard)" />
                <Input id="idFilterPackageInput"
                  width="12rem"
                  value="{objSearch>/filterPackage}"
                  placeholder="ZSCORT*"
                  submit=".onFilterPackageInputSubmit" />
              </VBox>

              <!-- Person Responsible -->
              <VBox class="sapUiTinyMarginEnd">
                <Label text="Person Responsible" />
                <Input id="idFilterAuthorInput"
                  width="10rem"
                  value="{objSearch>/filterAuthor}"
                  placeholder="USER*"
                  submit=".onFilterAuthorInputSubmit" />
              </VBox>

              <!-- Search Buttons -->
              <VBox justifyContent="End">
                <HBox>
                  <Button id="idSearchButton"
                    text="Search"
                    type="Emphasized"
                    icon="sap-icon://search"
                    press=".onSearchButtonPress"
                    class="sapUiTinyMarginEnd" />
                  <Button id="idClearButton"
                    text="Clear"
                    type="Transparent"
                    press=".onClearButtonPress"
                    class="sapUiTinyMarginEnd" />
                  <Button id="idNavTrReleaseButton"
                    text="TR Search / Release"
                    icon="sap-icon://shipping-status"
                    type="Emphasized"
                    press=".onButtonNavTrReleasePress"
                    tooltip="Open TR Search, then open a TR for Release / Apply" />
                </HBox>
              </VBox>

            </HBox>
          </content>
        </Panel>

        <IconTabBar
          id="idModeIconTabBar"
          selectedKey="{objSearch>/activeTab}"
          select=".onIconTabBarModeSelect"
          expandable="false"
          stretchContentHeight="true"
          class="sapUiNoContentPadding">
          <layoutData>
            <FlexItemData growFactor="1" />
          </layoutData>

          <!-- TAB 1: Local Objects (from TADIR) -->
          <items>
            <IconTabFilter
              key="local"
              text="Local (TADIR)"
              icon="sap-icon://database"
              count="{objSearch>/countLocal}">
              <content>
                <VBox height="100%" fitContainer="true">
                  <Toolbar>
                    <Title text="Objects on Local Server — S40" />
                    <ToolbarSpacer />
                    <Label text="{= ${objSearch>/countLocal} + ' object(s)'}" class="sapUiTinyMarginEnd" />
                    <Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onButtonExportLocalPress" />
                  </Toolbar>
                  <table:Table id="idLocalTable"
                    busy="{objSearch>/busyLocal}"
                    noData="{objSearch>/noDataText}"
                    selectionMode="Single"
                    rowSelectionChange=".onTableLocalSelectionChange"
                    alternateRowColors="true"
                    enableColumnReordering="true"
                    enableGrouping="true"
                    showColumnVisibilityMenu="true"
                    visibleRowCountMode="Auto"
                    minAutoRowCount="5"
                    rows="{path: 'objSearch>/localRows'}">
                    <table:layoutData>
                      <FlexItemData growFactor="1" />
                    </table:layoutData>
                    <table:columns>
                      <table:Column width="6rem" filterProperty="ObjectType" sortProperty="ObjectType">
                        <Label text="{= ${ddic>/LocalObjects/ObjectType} || 'Type' }" />
                        <table:template>
                          <ObjectStatus text="{objSearch>ObjectType}" state="None" />
                        </table:template>
                      </table:Column>
                      <table:Column width="20rem" filterProperty="ObjectName" sortProperty="ObjectName">
                        <Label text="{= ${ddic>/LocalObjects/ObjectName} || 'Object Name' }" />
                        <table:template>
                          <ObjectIdentifier title="{objSearch>ObjectName}" titleActive="true" titlePress=".onObjectIdentifierObjNameTitlePress" />
                        </table:template>
                      </table:Column>
                      <table:Column width="15rem" filterProperty="PackageName" sortProperty="PackageName">
                        <Label text="{= ${ddic>/LocalObjects/PackageName} || 'Package' }" />
                        <table:template>
                          <Text text="{objSearch>PackageName}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="10rem" filterProperty="PersonResponsible" sortProperty="PersonResponsible">
                        <Label text="{= ${ddic>/LocalObjects/PersonResponsible} || 'Person Resp.' }" />
                        <table:template>
                          <Text text="{objSearch>PersonResponsible}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="10rem" filterProperty="CreatedOn" sortProperty="CreatedOn">
                        <Label text="{= ${ddic>/LocalObjects/CreatedOn} || 'Created' }" />
                        <table:template>
                          <Text text="{path:'objSearch>CreatedOn', formatter:'.formatDate'}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="6rem">
                        <Label text="Actions" />
                        <table:template>
                          <HBox>
                            <Button icon="sap-icon://compare-2"
                              tooltip="Open in Code Compare"
                              type="Transparent"
                              customData:objType="{objSearch>ObjectType}"
                              customData:objName="{objSearch>ObjectName}"
                              press=".onButtonOpenComparePress" />
                            <Button icon="sap-icon://detail-view"
                              tooltip="View Source Code"
                              type="Transparent"
                              press=".onButtonViewSourcePress" />
                          </HBox>
                        </table:template>
                      </table:Column>
                    </table:columns>
                  </table:Table>
                </VBox>
              </content>
            </IconTabFilter>

            <!-- TAB 2: Target Objects (from ZA_SCORT_T) -->
            <IconTabFilter
              key="target"
              text="Target (Simulated)"
              icon="sap-icon://server-farm"
              count="{objSearch>/countTarget}">
              <content>
                <VBox height="100%" fitContainer="true">
                  <Toolbar>
                    <Title text="Objects on Target Server (Simulated via ZA_SCORT_T)" />
                    <ToolbarSpacer />
                    <Label text="{= ${objSearch>/countTarget} + ' object(s)'}" class="sapUiTinyMarginEnd" />
                    <Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onButtonExportTargetPress" />
                  </Toolbar>
                  <table:Table id="idTargetTable"
                    busy="{objSearch>/busyTarget}"
                    noData="{objSearch>/noDataText}"
                    selectionMode="Single"
                    rowSelectionChange=".onTableTargetSelectionChange"
                    alternateRowColors="true"
                    enableColumnReordering="true"
                    enableGrouping="true"
                    showColumnVisibilityMenu="true"
                    visibleRowCountMode="Auto"
                    minAutoRowCount="5"
                    rows="{path: 'objSearch>/targetRows'}">
                    <table:layoutData>
                      <FlexItemData growFactor="1" />
                    </table:layoutData>
                    <table:columns>
                      <table:Column width="6rem" filterProperty="ObjectType" sortProperty="ObjectType">
                        <Label text="{= ${ddic>/TargetObjects/ObjectType} || 'Type' }" />
                        <table:template>
                          <ObjectStatus text="{objSearch>ObjectType}" state="None" />
                        </table:template>
                      </table:Column>
                      <table:Column width="20rem" filterProperty="ObjectName" sortProperty="ObjectName">
                        <Label text="{= ${ddic>/TargetObjects/ObjectName} || 'Object Name' }" />
                        <table:template>
                          <ObjectIdentifier title="{objSearch>ObjectName}" titleActive="true" titlePress=".onObjectIdentifierObjNameTitlePress" />
                        </table:template>
                      </table:Column>
                      <table:Column width="15rem" filterProperty="PackageName" sortProperty="PackageName">
                        <Label text="{= ${ddic>/TargetObjects/PackageName} || 'Package' }" />
                        <table:template>
                          <Text text="{objSearch>PackageName}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="10rem" filterProperty="PersonResponsible" sortProperty="PersonResponsible">
                        <Label text="{= ${ddic>/TargetObjects/PersonResponsible} || 'Person Resp.' }" />
                        <table:template>
                          <Text text="{objSearch>PersonResponsible}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="10rem" filterProperty="CreatedOn" sortProperty="CreatedOn">
                        <Label text="{= ${ddic>/TargetObjects/CreatedOn} || 'Created' }" />
                        <table:template>
                          <Text text="{path:'objSearch>CreatedOn', formatter:'.formatDate'}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="6rem">
                        <Label text="Actions" />
                        <table:template>
                          <HBox>
                            <Button icon="sap-icon://compare-2"
                              tooltip="Open in Code Compare"
                              type="Transparent"
                              press=".onButtonOpenComparePress" />
                            <Button icon="sap-icon://detail-view"
                              tooltip="View Source Code"
                              type="Transparent"
                              press=".onButtonViewSourcePress" />
                          </HBox>
                        </table:template>
                      </table:Column>
                    </table:columns>
                  </table:Table>
                </VBox>
              </content>
            </IconTabFilter>

            <!-- TAB 3: Compare Matrix (BOTH / LOCAL_ONLY / TARGET_ONLY) -->
            <IconTabFilter
              key="matrix"
              text="Existence"
              icon="sap-icon://split"
              count="{objSearch>/countMatrix}">
              <content>
                <VBox height="100%" fitContainer="true">
                  <Toolbar>
                    <Title text="Existence status" />
                    <ToolbarSpacer />
                    <Label text="View code as server:" class="sapUiTinyMarginEnd" />
                    <SegmentedButton
                      selectedKey="{objSearch>/matrixServerType}"
                      selectionChange=".onSegmentedButtonMatrixServerSwitchSelectionChange">
                      <items>
                        <SegmentedButtonItem key="L" text="Local" />
                        <SegmentedButtonItem key="T" text="Target" />
                      </items>
                    </SegmentedButton>
                    <ToolbarSeparator />
                    <SegmentedButton
                      selectedKey="{objSearch>/matrixFilter}"
                      selectionChange=".onSegmentedButtonMatrixFilterSelectionChange">
                      <items>
                        <SegmentedButtonItem key="" text="All" />
                        <SegmentedButtonItem key="BOTH" text="BOTH" />
                        <SegmentedButtonItem key="LOCAL_ONLY" text="LOCAL ONLY" />
                        <SegmentedButtonItem key="TARGET_ONLY" text="TARGET ONLY" />
                      </items>
                    </SegmentedButton>
                    <Button icon="sap-icon://refresh" tooltip="Reload" press=".onButtonSearchMatrixPress" type="Transparent" />
                  </Toolbar>
                  <table:Table id="idMatrixTable"
                    busy="{objSearch>/busyMatrix}"
                    selectionMode="Single"
                    alternateRowColors="true"
                    enableColumnReordering="true"
                    enableGrouping="true"
                    showColumnVisibilityMenu="true"
                    visibleRowCountMode="Auto"
                    minAutoRowCount="5"
                    rows="{
                      path: 'objModel>/CompareMatrix',
                      parameters: {
                        $count: true
                      }
                    }">
                    <table:layoutData>
                      <FlexItemData growFactor="1" />
                    </table:layoutData>
                    <table:columns>
                      <table:Column width="6rem" filterProperty="ObjectType" sortProperty="ObjectType">
                        <Label text="{= ${ddic>/CompareMatrix/ObjectType} || 'Type' }" />
                        <table:template>
                          <ObjectStatus text="{objModel>ObjectType}" state="None" />
                        </table:template>
                      </table:Column>
                      <table:Column width="20rem" filterProperty="ObjectName" sortProperty="ObjectName">
                        <Label text="{= ${ddic>/CompareMatrix/ObjectName} || 'Object Name' }" />
                        <table:template>
                          <ObjectIdentifier title="{objModel>ObjectName}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="8rem" filterProperty="ExistenceStatus" sortProperty="ExistenceStatus">
                        <Label text="{= ${ddic>/CompareMatrix/ExistenceStatus} || 'Status' }" />
                        <table:template>
                          <ObjectStatus
                            text="{objModel>ExistenceStatus}"
                            state="{path:'objModel>ExistenceStatus', formatter:'.formatExistenceState'}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="15rem" filterProperty="LocalPackage" sortProperty="LocalPackage">
                        <Label text="{= ${ddic>/CompareMatrix/LocalPackage} || 'Local Package' }" />
                        <table:template>
                          <Text text="{objModel>LocalPackage}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="15rem" filterProperty="TargetPackage" sortProperty="TargetPackage">
                        <Label text="{= ${ddic>/CompareMatrix/TargetPackage} || 'Target Package' }" />
                        <table:template>
                          <Text text="{objModel>TargetPackage}" />
                        </table:template>
                      </table:Column>
                      <table:Column width="6rem">
                        <Label text="Actions" />
                        <table:template>
                          <HBox>
                            <Button icon="sap-icon://compare-2"
                              tooltip="Open in Code Compare"
                              type="Transparent"
                              visible="{= ${objModel>ExistenceStatus} === 'BOTH' }"
                              press=".onButtonOpenComparePress" />
                            <Button icon="sap-icon://detail-view"
                              tooltip="View Source Code"
                              type="Transparent"
                              press=".onButtonViewSourcePress" />
                          </HBox>
                        </table:template>
                      </table:Column>
                    </table:columns>
                  </table:Table>
                </VBox>
              </content>
            </IconTabFilter>
          </items>
        </IconTabBar>

      </VBox>
    </content>
  </Page>

</mvc:View>
