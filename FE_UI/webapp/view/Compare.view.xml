<mvc:View
  controllerName="zscort.app.controller.Compare"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  xmlns:table="sap.ui.table"
  xmlns:layout="sap.ui.layout"
  height="100%">

  <f:DynamicPage id="idDetailDynamicPage" fitContent="true" toggleHeaderOnTitleClick="false" class="sapUiNoContentPadding">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="{detail>/ObjectType} {detail>/ObjectName}" />
        </f:heading>
        <f:navigationActions>
          <Button icon="sap-icon://full-screen" type="Transparent" press=".onButtonFullScreenPress" tooltip="Toggle Full Screen" />
          <Button icon="sap-icon://decline" type="Transparent" press=".onButtonCloseComparePress" tooltip="{i18n>btnClose}" />
        </f:navigationActions>
      </f:DynamicPageTitle>
    </f:title>

    <f:content>
      <IconTabBar id="idCompareIconTabBar" class="sapUiNoContentPadding" stretchContentHeight="true" select=".onTabSelect">
        <items>
          <!-- TAB 1: Git Review (Local vs Target) -->
          <IconTabFilter key="gitReview" text="{i18n>tabGitReview}" icon="sap-icon://compare">
            <VBox height="100%" width="100%" class="sapUiNoContentPadding" fitContainer="true">
              <OverflowToolbar id="idGitReviewToolbar">
                <ObjectStatus text="{= ${detail>/isNotSupported} ? 'NOT_SUPPORTED' : (${detail>/localExists} ? ${i18n>statusLocalActive} : ${i18n>lblLocalNotAvailable}) }" state="{= ${detail>/isNotSupported} ? 'Information' : (${detail>/localExists} ? 'Indication05' : 'None') }" class="sapUiTinyMarginEnd" />
                <Title text="{i18n>lblVs}" visible="{= !${detail>/isNotSupported} }" />
                <ObjectStatus text="{= ${detail>/targetExists} ? ${i18n>statusTargetSnapshot} : ${i18n>lblTargetNotAvailable} }" state="{= ${detail>/targetExists} ? 'Indication04' : 'Warning' }" class="sapUiTinyMarginBegin" visible="{= !${detail>/isNotSupported} }" />
                <ToolbarSpacer />
                <SegmentedButton
                  id="btnCompareViewMode"
                  selectedKey="{detail>/compareMode}"
                  selectionChange=".onCompareModeChange"
                  visible="{= !${detail>/isNotSupported} &amp;&amp; (${detail>/ObjectType} === 'DOMA' || ${detail>/ObjectType} === 'DTEL' || ${detail>/ObjectType} === 'MSAG' || ${detail>/ObjectType} === 'DEVC') }">
                  <items>
                    <SegmentedButtonItem key="form" icon="sap-icon://form" text="ADT Form Diff" />
                    <SegmentedButtonItem key="text" icon="sap-icon://document-text" text="Text DDL Diff" />
                  </items>
                </SegmentedButton>
                <ToolbarSeparator visible="{= !${detail>/isNotSupported} &amp;&amp; (${detail>/ObjectType} === 'DOMA' || ${detail>/ObjectType} === 'DTEL' || ${detail>/ObjectType} === 'MSAG' || ${detail>/ObjectType} === 'DEVC') }" />
                <Button icon="sap-icon://navigation-up-arrow" text="{i18n>btnPrevDiff}" type="Transparent" press=".onMonacoPrevDiffGit" tooltip="{i18n>btnPrevDiff}" visible="{= !${detail>/isNotSupported} }" />
                <Button icon="sap-icon://navigation-down-arrow" text="{i18n>btnNextDiff}" type="Transparent" press=".onMonacoNextDiffGit" tooltip="{i18n>btnNextDiff}" visible="{= !${detail>/isNotSupported} }" />
                <ToolbarSeparator visible="{= !${detail>/isNotSupported} }" />
                <Button icon="sap-icon://header" text="{i18n>btnSingleColumn}" type="Transparent" press=".onMonacoToggleSideBySideGit" tooltip="{i18n>btnToggleDiffLayout}" visible="{= !${detail>/isNotSupported} }" />
                <ToolbarSeparator visible="{= !${detail>/isNotSupported} }" />
                <Button id="btnGitAiToggle"
                  icon="sap-icon://ai"
                  text="{i18n>btnAiReview}"
                  type="{= ${detail>/showGitAiPanel} ? 'Emphasized' : 'Default' }"
                  press=".onToggleGitAiPanel"
                  tooltip="{i18n>btnAiReviewTooltip}"
                  visible="{= !${detail>/isNotSupported} }" />
              </OverflowToolbar>

              <!-- Splitter: Left Monaco Diff / ADT Form Diff + Right AI Review Panel -->
              <layout:Splitter height="100%" width="100%">
                <VBox width="100%" height="100%" class="sapUiNoContentPadding" fitContainer="true">
                  <layoutData>
                    <layout:SplitterLayoutData size="{= ${detail>/showGitAiPanel} ? '65%' : '100%' }" />
                  </layoutData>

                  <!-- Not Supported Container -->
                  <VBox visible="{detail>/isNotSupported}" class="sapUiMediumMargin" alignItems="Center" justifyContent="Center" height="100%">
                    <IllustratedMessage
                      illustrationType="sapIllus-NoData"
                      title="Object Detail Not Supported"
                      description="Source code / ADT detail view is not supported for {detail>/ObjectType} (requires SAP GUI in ADT Eclipse). Only metadata is available." />
                  </VBox>

                  <!-- Monaco Git Container -->
                  <VBox id="monacoGitContainer" width="100%" height="100%" class="sapUiNoContentPadding" visible="{= !${detail>/isNotSupported} &amp;&amp; ${detail>/compareMode} !== 'form' }" />

                  <!-- ADT Form Diff Container -->
                  <ScrollContainer
                    id="idAdtFormDiffContainer"
                    height="100%"
                    width="100%"
                    vertical="true"
                    visible="{= !${detail>/isNotSupported} &amp;&amp; ${detail>/compareMode} === 'form' &amp;&amp; (${detail>/ObjectType} === 'DOMA' || ${detail>/ObjectType} === 'DTEL' || ${detail>/ObjectType} === 'MSAG' || ${detail>/ObjectType} === 'DEVC') }">
                    <layout:Grid defaultSpan="L6 M6 S12" class="sapUiNoContentPadding">
                      <!-- Left Column: Local ADT Form -->
                      <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                          <ObjectStatus text="Local (Active)" state="Success" class="sapUiTinyMarginEnd" />
                          <Title text="{detail>/ObjectType}: {detail>/ObjectName}" level="H4" />
                        </HBox>
                        <VBox visible="{= ${detail>/ObjectType} === 'DOMA' }">
                          <core:Fragment fragmentName="zscort.app.view.fragment.DomainForm" type="XML" />
                        </VBox>
                        <VBox visible="{= ${detail>/ObjectType} === 'DTEL' }">
                          <core:Fragment fragmentName="zscort.app.view.fragment.DataElementForm" type="XML" />
                        </VBox>
                        <VBox visible="{= ${detail>/ObjectType} === 'MSAG' }">
                          <core:Fragment fragmentName="zscort.app.view.fragment.MessageClassForm" type="XML" />
                        </VBox>
                        <VBox visible="{= ${detail>/ObjectType} === 'DEVC' }">
                          <core:Fragment fragmentName="zscort.app.view.fragment.PackageForm" type="XML" />
                        </VBox>
                      </VBox>

                      <!-- Right Column: Target ADT Form -->
                      <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                          <ObjectStatus text="Target (Snapshot)" state="Warning" class="sapUiTinyMarginEnd" />
                          <Title text="{detail>/ObjectType}: {detail>/ObjectName}" level="H4" />
                        </HBox>
                        <VBox visible="{= ${detail>/ObjectType} === 'DOMA' }">
                          <core:Fragment fragmentName="zscort.app.view.fragment.DomainFormTarget" type="XML" />
                        </VBox>
                        <VBox visible="{= ${detail>/ObjectType} === 'DTEL' }">
                          <core:Fragment fragmentName="zscort.app.view.fragment.DataElementFormTarget" type="XML" />
                        </VBox>
                        <VBox visible="{= ${detail>/ObjectType} === 'MSAG' }">
                          <core:Fragment fragmentName="zscort.app.view.fragment.MessageClassFormTarget" type="XML" />
                        </VBox>
                        <VBox visible="{= ${detail>/ObjectType} === 'DEVC' }">
                          <core:Fragment fragmentName="zscort.app.view.fragment.PackageFormTarget" type="XML" />
                        </VBox>
                      </VBox>
                    </layout:Grid>
                  </ScrollContainer>
                </VBox>

                <!-- Right: AI Review Side Panel -->
                <VBox id="idGitAiPanel" height="100%" visible="{detail>/showGitAiPanel}" fitContainer="true" class="sapUiNoContentPadding">
                  <layoutData>
                    <layout:SplitterLayoutData size="{= ${detail>/showGitAiPanel} ? '35%' : '0%' }" resizable="true" />
                  </layoutData>
                  <core:Fragment id="idGitAiFrag" fragmentName="zscort.app.view.AiSidePanel" type="XML" />
                </VBox>
              </layout:Splitter>
            </VBox>
          </IconTabFilter>

          <!-- TAB 2: Version Management (ADT Style) -->
          <IconTabFilter key="versionMgmt" text="{i18n>tabVersionHistory}" icon="sap-icon://history">
            <layout:Splitter orientation="Vertical" width="100%" height="100%">
              <!-- Top Pane: Version Table -->
              <VBox height="100%">
                <layoutData>
                  <layout:SplitterLayoutData size="40%" />
                </layoutData>
                <table:Table
                  id="idVersionsTable"
                  selectionMode="MultiToggle"
                  rowSelectionChange=".onVersionSelectionChange"
                  visibleRowCountMode="Auto"
                  busy="{detail>/busyVersions}"
                  rows="{path: 'detail>/versions'}">
                  <table:extension>
                    <OverflowToolbar>
                      <Title text="{i18n>selectTwoVersions}" />
                      <ToolbarSpacer />
                      <Button id="btnViewSingleVers" icon="sap-icon://document-text" text="{i18n>btnViewVersionSource}" type="Transparent" press=".onViewVersionSourcePress" enabled="{= ${detail>/selectedVersionCount} === 1 }" />
                      <Button icon="sap-icon://refresh" text="{i18n>btnRefresh}" press=".onReloadVersions" type="Transparent" />
                      <Button id="btnCompare" icon="sap-icon://compare-2" text="{i18n>btnCompareSelected}" type="Emphasized" press=".onComparePress" enabled="false" />
                    </OverflowToolbar>
                  </table:extension>
                  <table:columns>
                    <table:Column width="4rem" hAlign="Center">
                      <Label text="{i18n>colStatus}" />
                      <table:template>
                        <core:Icon
                          src="{= ${detail>VersionNo} === '99998' ? 'sap-icon://sys-enter-2' : 'sap-icon://sys-help-2' }"
                          color="{= ${detail>VersionNo} === '99998' ? 'Positive' : 'Critical' }" />
                      </table:template>
                    </table:Column>
                    <table:Column width="6rem">
                      <Label text="{i18n>serverId}" />
                      <table:template>
                        <ObjectStatus text="{= ${detail>ServerType} === 'L' ? 'Local' : 'Target' }" state="{= ${detail>ServerType} === 'L' ? 'Information' : 'Warning' }" />
                      </table:template>
                    </table:Column>
                    <table:Column width="6rem">
                      <Label text="{i18n>versionNo}" />
                      <table:template>
                        <Text text="{path: 'detail>VersionNo', formatter: '.formatVersionNo'}" />
                      </table:template>
                    </table:Column>
                    <table:Column width="8rem">
                      <Label text="{i18n>authorLabel}" />
                      <table:template>
                        <Text text="{detail>Author}" />
                      </table:template>
                    </table:Column>
                    <table:Column width="10rem">
                      <Label text="{i18n>colDateTime}" />
                      <table:template>
                        <Text text="{path: 'detail>Datum', formatter: '.formatDate'} {detail>Uzeit}" />
                      </table:template>
                    </table:Column>
                    <table:Column width="10rem">
                      <Label text="{i18n>colRequest}" />
                      <table:template>
                        <Text text="{detail>Korrnum}" />
                      </table:template>
                    </table:Column>
                    <table:Column width="auto">
                      <Label text="{i18n>colRequestText}" />
                      <table:template>
                        <Text text="{detail>Message}" wrapping="false" />
                      </table:template>
                    </table:Column>
                    <!-- Action Column: View single version source -->
                    <table:Column width="3.5rem" hAlign="Center">
                      <Label text="" />
                      <table:template>
                        <Button icon="sap-icon://document-text" type="Transparent" tooltip="{i18n>btnViewVersionSource}" press=".onRowViewSourcePress" />
                      </table:template>
                    </table:Column>
                  </table:columns>
                </table:Table>
              </VBox>

              <!-- Bottom Pane: Monaco Editor for Version History -->
              <VBox height="100%" visible="{detail>/showEditor}" fitContainer="true" class="sapUiNoContentPadding">
                <layoutData>
                  <layout:SplitterLayoutData size="60%" />
                </layoutData>
                <OverflowToolbar id="idEditorToolbar" visible="{detail>/showEditor}">
                  <ObjectStatus text="{i18n>lblLeft}: {detail>/leftTitle}" state="Indication05" class="sapUiTinyMarginEnd" />
                  <Title text="{i18n>lblVs}" />
                  <ObjectStatus text="{i18n>lblRight}: {detail>/rightTitle}" state="Indication04" class="sapUiTinyMarginBegin" />
                  <ToolbarSpacer />
                  <Button icon="sap-icon://navigation-up-arrow" text="{i18n>btnPrevDiff}" type="Transparent" press=".onMonacoPrevDiffVers" tooltip="{i18n>btnPrevDiff}" />
                  <Button icon="sap-icon://navigation-down-arrow" text="{i18n>btnNextDiff}" type="Transparent" press=".onMonacoNextDiffVers" tooltip="{i18n>btnNextDiff}" />
                  <ToolbarSeparator />
                  <Button icon="sap-icon://header" text="{i18n>btnSingleColumn}" type="Transparent" press=".onMonacoToggleSideBySideVers" tooltip="{i18n>btnToggleDiffLayout}" />
                  <ToolbarSeparator />
                  <Button id="btnVersAiToggle"
                    icon="sap-icon://ai"
                    text="{i18n>btnAiReview}"
                    type="{= ${detail>/showVersAiPanel} ? 'Emphasized' : 'Default' }"
                    press=".onToggleVersAiPanel"
                    tooltip="{i18n>btnAiReviewTooltip}" />
                </OverflowToolbar>

                <!-- Splitter: Left Monaco Version Diff + Right AI Review Panel -->
                <layout:Splitter height="100%" width="100%">
                  <VBox id="monacoVersContainer" width="100%" height="100%" class="sapUiNoContentPadding">
                    <layoutData>
                      <layout:SplitterLayoutData size="{= ${detail>/showVersAiPanel} ? '65%' : '100%' }" />
                    </layoutData>
                  </VBox>

                  <!-- Right: AI Review Side Panel for Versions -->
                  <VBox id="idVersAiPanel" height="100%" visible="{detail>/showVersAiPanel}" fitContainer="true" class="sapUiNoContentPadding">
                    <layoutData>
                      <layout:SplitterLayoutData size="{= ${detail>/showVersAiPanel} ? '35%' : '0%' }" resizable="true" />
                    </layoutData>
                    <core:Fragment id="idVersAiFrag" fragmentName="zscort.app.view.AiSidePanel" type="XML" />
                  </VBox>
                </layout:Splitter>
              </VBox>
            </layout:Splitter>
          </IconTabFilter>

          <!-- TAB 3: AI Review -->
          <IconTabFilter key="aiReview" text="{i18n>tabAiReview}" icon="sap-icon://ai">
            <VBox class="sapUiSmallMargin">
              <!-- Header / Trigger Toolbar with 2 Actions -->
              <OverflowToolbar>
                <core:Icon src="sap-icon://ai" class="sapUiSmallMarginEnd" />
                <Title text="{i18n>aiReviewTitle}" />
                <ToolbarSpacer />
                <Label text="{i18n>lblAiModel}:" class="sapUiTinyMarginEnd" />
                <Select
                  id="sbAiModel"
                  selectedKey="{detail>/aiModel}"
                  change=".onAiModelChange"
                  tooltip="{i18n>aiSelectModelTooltip}"
                  class="sapUiTinyMarginEnd"
                  autoAdjustWidth="true">
                  <core:Item key="gemini-3.5-flash" text="Gemini 3.5 Flash" />
                  <core:Item key="gemini-3-flash" text="Gemini 3 Flash" />
                  <core:Item key="gemini-2.5-flash" text="Gemini 2.5 Flash" />
                  <core:Item key="gemini-2.5-flash-lite" text="Gemini 2.5 Flash Lite" />
                  <core:Item key="antigravity" text="Antigravity" />
                </Select>
                <Label text="{i18n>lblAiMode}:" class="sapUiTinyMarginEnd" />
                <SegmentedButton
                  id="sbAiMode"
                  selectedKey="{= ${detail>/aiExecutionMode} || 'BE_SAP' }"
                  class="sapUiTinyMarginEnd">
                  <items>
                    <SegmentedButtonItem key="BE_SAP" text="{i18n>aiModeSapBackend}" tooltip="{i18n>aiModeSapTooltip}" icon="sap-icon://sap-logo-shape" />
                    <SegmentedButtonItem key="FE_DIRECT" text="{i18n>aiModeDirectClient}" tooltip="{i18n>aiModeDirectTooltip}" icon="sap-icon://cloud" />
                  </items>
                </SegmentedButton>
                <ToolbarSeparator />
                <Button id="btnAiSyntaxCheck"
                  icon="sap-icon://syntax"
                  text="{i18n>btnAiSyntaxCheck}"
                  type="Emphasized"
                  press=".onAiSyntaxCheckPress"
                  class="sapUiTinyMarginEnd" />
                <Button id="btnAiTransportReview"
                  icon="sap-icon://shipping-status"
                  text="{i18n>btnAiTransportReview}"
                  type="Accept"
                  press=".onAiTransportReviewPress" />
              </OverflowToolbar>

              <!-- Loading state -->
              <HBox
                id="idAiLoading"
                visible="false"
                alignItems="Center"
                class="sapUiMediumMargin">
                <BusyIndicator size="1rem" class="sapUiSmallMarginEnd" />
                <Text id="idAiLoadingText" text="{i18n>aiReviewAnalyzing}" />
              </HBox>

              <!-- ACTION 1: Syntax & Code Quality Result Panel -->
              <Panel id="idAiSyntaxResultPanel" headerText="{i18n>aiSyntaxPanelTitle}" expandable="true" expanded="true" visible="false" class="sapUiSmallMarginTop">
                <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMargin sapUiSmallMarginBottom">
                  <ObjectStatus
                    id="idAiSyntaxStatus"
                    text="—"
                    state="None"
                    class="sapUiSmallMarginEnd" />
                  <ObjectStatus
                    id="idAiSyntaxScore"
                    text="—"
                    state="Information"
                    class="sapUiSmallMarginEnd" />
                  <ObjectStatus
                    id="idAiCleanVerdict"
                    text="—"
                    state="None"
                    class="sapUiSmallMarginEnd" />
                  <ObjectStatus
                    id="idAiBetterSide"
                    text=""
                    state="Success"
                    visible="false" />
                </HBox>

                <!-- Comparison & Best-Practice Recommendation (when both Local & Target exist) -->
                <VBox id="idAiComparisonBox" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" visible="false">
                  <Title text="{i18n>aiComparisonTitle}" level="H5" class="sapUiTinyMarginBottom" />
                  <MessageStrip
                    id="idAiBetterSideReasonStrip"
                    text=""
                    type="Information"
                    showIcon="true"
                    class="sapUiTinyMarginBottom" />
                  <MessageStrip
                    id="idAiBestRecommendationStrip"
                    text=""
                    type="Success"
                    showIcon="true" />
                </VBox>

                <!-- Syntax Summary -->
                <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
                  <Title text="{i18n>aiSyntaxSummaryTitle}" level="H5" />
                  <Text id="idAiSyntaxSummaryText" text="—" wrapping="true" class="sapUiTinyMarginTop" />
                </VBox>

                <!-- Syntax & Quality Findings -->
                <VBox id="idAiFindingsBox" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
                  <Title text="{i18n>aiFindingsTitle}" level="H5" />
                  <List id="idAiFindingsList" class="sapUiTinyMarginTop" noDataText="{i18n>aiNoSyntaxErrors}">
                  </List>
                </VBox>
              </Panel>

              <!-- ACTION 2: Transport Recommendation Result Panel -->
              <Panel id="idAiTransportResultPanel" headerText="{i18n>aiTransportPanelTitle}" expandable="true" expanded="true" visible="false" class="sapUiSmallMarginTop">
                <!-- Impact Badge + Recommendation -->
                <HBox alignItems="Center" class="sapUiSmallMargin sapUiSmallMarginBottom">
                  <ObjectStatus
                    id="idAiImpactStatus"
                    text="—"
                    state="None"
                    class="sapUiSmallMarginEnd" />
                  <ObjectStatus
                    id="idAiRecommendStatus"
                    text="—"
                    state="None" />
                </HBox>

                <!-- Summary -->
                <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
                  <Title text="{i18n>aiSummaryTitle}" level="H5" />
                  <Text id="idAiSummaryText" text="—" wrapping="true" class="sapUiTinyMarginTop" />
                </VBox>

                <!-- Risks -->
                <VBox id="idAiRisksBox" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" visible="false">
                  <Title text="{i18n>aiRisksTitle}" level="H5" />
                  <List id="idAiRisksList" class="sapUiTinyMarginTop">
                  </List>
                </VBox>

                <!-- Transport Notes & Pre/Post-Import Precautions -->
                <VBox id="idAiNotesBox" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" visible="false">
                  <Title text="{i18n>aiNotesTitle}" level="H5" />
                  <List id="idAiNotesList" class="sapUiTinyMarginTop">
                  </List>
                </VBox>

                <!-- Reason -->
                <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
                  <Title text="{i18n>aiReasonTitle}" level="H5" />
                  <Text id="idAiReasonText" text="—" wrapping="true" class="sapUiTinyMarginTop" />
                </VBox>
              </Panel>

              <!-- Error state -->
              <MessageStrip
                id="idAiError"
                text=""
                type="Error"
                showIcon="true"
                visible="false"
                class="sapUiSmallMarginTop" />
            </VBox>
          </IconTabFilter>

        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>

</mvc:View>
