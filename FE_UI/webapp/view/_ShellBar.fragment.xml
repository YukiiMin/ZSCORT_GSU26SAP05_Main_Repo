<core:FragmentDefinition
  xmlns="sap.f"
  xmlns:core="sap.ui.core"
  xmlns:m="sap.m">

  <ShellBar
    id="scortShellBar"
    title="SCORT"
    subtitle="{i18n>appDescription}"
    primaryTitle="SCORT"
    showMenuButton="true"
    menuButtonPress=".onMenuPress"
    homeIconPressed=".onHomePress">

    <additionalContent>
      <!-- Navigation Menu Items injected programmatically via controller -->
      <m:OverflowToolbar design="Transparent" style="Clear">
        <m:Button
          id="btnNavObjSearch"
          text="{i18n>navObjSearch}"
          type="{= ${appView>/currentModule} === 'objSearch' ? 'Emphasized' : 'Transparent' }"
          press=".onNavObjSearch" />
        <m:Button
          id="btnNavTrSearch"
          text="{i18n>navTrSearch}"
          type="{= ${appView>/currentModule} === 'trSearch' ? 'Emphasized' : 'Transparent' }"
          press=".onNavTrSearch" />
        <m:ToolbarSeparator />
        <m:MenuButton
          icon="sap-icon://world"
          text="{= (${appView>/currentLanguage} || 'en').toUpperCase() }"
          tooltip="Language / Ngôn ngữ">
          <m:menu>
            <m:Menu itemSelected=".onLanguageMenuSelect">
              <m:items>
                <m:MenuItem key="en" text="🇬🇧 English" />
                <m:MenuItem key="vi" text="🇻🇳 Tiếng Việt" />
                <m:MenuItem key="ja" text="🇯🇵 日本語" />
                <m:MenuItem key="zh" text="🇨🇳 中文" />
                <m:MenuItem key="de" text="🇩🇪 Deutsch" />
              </m:items>
            </m:Menu>
          </m:menu>
        </m:MenuButton>
      </m:OverflowToolbar>
    </additionalContent>

  </ShellBar>

</core:FragmentDefinition>
