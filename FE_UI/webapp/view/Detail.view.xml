<mvc:View
  controllerName="zscort.app.controller.Detail"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:table="sap.ui.table">

  <Page id="idDetailPage" showHeader="true" backgroundDesign="List">
    <customHeader>
      <Bar>
        <contentLeft>
          <Button
            icon="sap-icon://nav-back"
            text="TR List"
            press=".onButtonNavBackPress"
            type="Transparent"
            tooltip="Back to Transport Request list" />
          <Title text="TR Objects: {detail>/trkorr}" class="sapUiTinyMarginBegin" />
        </contentLeft>
        <contentRight>
          <Button text="Apply to Target" press=".onApplyToTargetButtonPress" type="Emphasized" tooltip="Apply to Target after compare (Released TR)" />
          <Button icon="sap-icon://refresh" press=".onButtonRefreshPress" type="Transparent" tooltip="Refresh Status" />
          <Button
            icon="sap-icon://home"
            type="Transparent"
            press=".onButtonNavObjSearchPress"
            tooltip="Back to Object Search" />
          <Button icon="sap-icon://decline" press=".onButtonCloseDetailPress" type="Transparent" tooltip="Close detail" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <VBox height="100%">
        <ObjectHeader
          title="{detail>/trkorr}"
          intro="Selected Transport Request">
          <attributes>
            <ObjectAttribute title="{= ${ddic>/ZCE_SCORT_TR_VH/As4date} || 'Date' }" text="{path: 'detail>/as4date', formatter: '.formatDate'}" />
            <ObjectAttribute title="Info" text="{detail>/message}" />
          </attributes>
        </ObjectHeader>

        <table:Table
          id="idObjectsTable"
          selectionMode="None"
          visibleRowCount="12"
          busy="{detail>/busy}"
          noData="{= ${detail>/message} || 'No data' }"
          rows="{path: 'detail>/objects'}">

          <table:columns>
            <table:Column width="5rem">
              <Label text="{= ${ddic>/TrCmp/ObjectType} || 'Type' }" />
              <table:template>
                <Text text="{detail>ObjectType}" />
              </table:template>
            </table:Column>

            <table:Column>
              <Label text="{= ${ddic>/TrCmp/ObjectName} || 'Object Name' }" />
              <table:template>
                <ObjectIdentifier title="{detail>ObjectName}" />
              </table:template>
            </table:Column>

            <table:Column width="10rem">
              <Label text="{= ${ddic>/TrCmp/CompareStatus} || 'Compare Status' }" />
              <table:template>
                <ObjectStatus
                  text="{detail>CompareStatus}"
                  state="{path: 'detail>CompareStatus', formatter: '.formatCompareStatus'}"
                  icon="{path: 'detail>CompareStatus', formatter: '.formatCompareIcon'}" />
              </table:template>
            </table:Column>

            <table:Column width="7rem">
              <Label text="Action" />
              <table:template>
                <HBox>
                  <Button
                    tooltip="Compare Code"
                    icon="sap-icon://compare-2"
                    type="Transparent"
                    enabled="{= ${detail>CompareStatus} !== 'NOT_SUPPORTED' }"
                    press=".onButtonComparePress" />
                  <Button
                    tooltip="View Source Code"
                    icon="sap-icon://detail-view"
                    type="Transparent"
                    enabled="{= ${detail>CompareStatus} !== 'NOT_SUPPORTED' }"
                    press=".onButtonViewSourcePress" />
                </HBox>
              </table:template>
            </table:Column>
          </table:columns>
        </table:Table>
      </VBox>
    </content>
  </Page>

</mvc:View>
