<mvc:View
  controllerName="zscort.app.controller.TrSearch"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  xmlns:table="sap.ui.table"
  height="100%">

  <Page id="trSearchPage" showHeader="true" backgroundDesign="List" enableScrolling="false">

    <customHeader>
      <Bar>
        <contentLeft>
          <Title text="{i18n>trSearchTitle}" />
        </contentLeft>
        <contentMiddle>
          <SegmentedButton
            selectedKey="{appView>/currentModule}"
            selectionChange=".onModuleSwitch">
            <items>
              <SegmentedButtonItem key="objSearch" text="{i18n>navObjSearch}" icon="sap-icon://search" />
              <SegmentedButtonItem key="trSearch"  text="{i18n>navTrSearch}"     icon="sap-icon://org-chart" />
            </items>
          </SegmentedButton>
        </contentMiddle>
        <contentRight>
          <MenuButton
            icon="sap-icon://world"
            text="{= (${appView>/currentLanguage} || 'en').toUpperCase() }"
            tooltip="Language / Ngôn ngữ"
            class="sapUiTinyMarginEnd">
            <menu>
              <Menu itemSelected=".onLanguageMenuSelect">
                <items>
                  <MenuItem key="en" text="🇬🇧 English" />
                  <MenuItem key="vi" text="🇻🇳 Tiếng Việt" />
                  <MenuItem key="ja" text="🇯🇵 日本語" />
                  <MenuItem key="zh" text="🇨🇳 中文" />
                  <MenuItem key="de" text="🇩🇪 Deutsch" />
                </items>
              </Menu>
            </menu>
          </MenuButton>
          <Button icon="sap-icon://home" type="Transparent" press=".onNavObjSearch" tooltip="Home — Object Search" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <VBox height="100%" fitContainer="true">

        <Panel headerText="{i18n>searchFilterPanel}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
          <content>
            <HBox class="scortFilterBox sapUiTinyMargin">

              <!-- TR Number -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>trkorrFilter}" />
                <Input id="inputTrkorr"
                  value="{trSearch>/filterTrkorr}"
                  placeholder="S40K*"
                  submit=".onSearch" />
              </VBox>

              <!-- Owner -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>ownerFilter}" />
                <Input id="inputOwner"
                  value="{trSearch>/filterOwner}"
                  placeholder="e.g. DEV*"
                  submit=".onSearch" />
              </VBox>

              <!-- Date From -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>dateFromFilter}" />
                <DatePicker
                  id="dpDateFrom"
                  value="{trSearch>/filterDateFrom}"
                  valueFormat="yyyyMMdd"
                  displayFormat="dd.MM.yyyy" />
              </VBox>

              <!-- Date To -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>dateToFilter}" />
                <DatePicker
                  id="dpDateTo"
                  value="{trSearch>/filterDateTo}"
                  valueFormat="yyyyMMdd"
                  displayFormat="dd.MM.yyyy" />
              </VBox>

              <!-- TR Status -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>statusFilter}" />
                <Select id="selStatus"
                  selectedKey="{trSearch>/filterStatus}"
                  forceSelection="false">
                  <items>
                    <core:Item key=""  text="{i18n>allTypes}" />
                    <core:Item key="D" text="D — Modifiable" />
                    <core:Item key="R" text="R — Released" />
                  </items>
                </Select>
              </VBox>

              <!-- Object Name Filter -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>colObjName}" />
                <Input id="inputObjName"
                  value="{trSearch>/filterObjName}"
                  placeholder="e.g. Z* / ZCL_*"
                  submit=".onSearch" />
              </VBox>

              <!-- Object Type Filter -->
              <VBox class="scortFilterItem">
                <Label text="{i18n>colType}" />
                <Select id="selObjType"
                  selectedKey="{trSearch>/filterObjType}"
                  forceSelection="false">
                  <items>
                    <core:Item key="" text="{i18n>allTypes}" />
                    <core:Item key="PROG" text="PROG — Program" />
                    <core:Item key="CLAS" text="CLAS — Class" />
                    <core:Item key="INTF" text="INTF — Interface" />
                    <core:Item key="FUNC" text="FUNC — Function Module" />
                    <core:Item key="FUGR" text="FUGR — Function Group" />
                    <core:Item key="DDLS" text="DDLS — CDS View" />
                    <core:Item key="BDEF" text="BDEF — Behavior Definition" />
                    <core:Item key="DCLS" text="DCLS — Access Control" />
                    <core:Item key="DDLX" text="DDLX — Metadata Extension" />
                    <core:Item key="SRVD" text="SRVD — Service Definition" />
                    <core:Item key="TABL" text="TABL — Table / Structure" />
                    <core:Item key="DTEL" text="DTEL — Data Element" />
                    <core:Item key="DOMA" text="DOMA — Domain" />
                    <core:Item key="TTYP" text="TTYP — Table Type" />
                    <core:Item key="VIEW" text="VIEW — Database View" />
                    <core:Item key="MSAG" text="MSAG — Message Class" />
                    <core:Item key="DEVC" text="DEVC — Package" />
                    <core:Item key="TRAN" text="TRAN — Transaction" />
                    <core:Item key="NROB" text="NROB — Number Range" />
                    <core:Item key="WAPA" text="WAPA — BSP Application" />
                    <core:Item key="SSFO" text="SSFO — Smart Form" />
                    <core:Item key="SHLP" text="SHLP — Search Help" />
                  </items>
                </Select>
              </VBox>

              <VBox class="scortFilterButtons" justifyContent="End">
                <HBox wrap="Wrap" class="scortFilterButtons">
                  <Button text="{i18n>searchBtn}" type="Emphasized" icon="sap-icon://search"
                    press=".onSearch" class="sapUiTinyMarginEnd" />
                  <Button text="{i18n>clearBtn}"  type="Transparent" press=".onClearFilter" />
                </HBox>
              </VBox>

            </HBox>
          </content>
        </Panel>

        <IconTabBar
          id="tabBarTrMode"
          selectedKey="{trSearch>/activeTab}"
          select=".onTabSelect"
          expandable="false"
          stretchContentHeight="true"
          class="sapUiNoContentPadding">
          <layoutData>
            <FlexItemData growFactor="1" />
          </layoutData>

          <items>

            <!-- TAB 1: TR Tree (sap.ui.table.TreeTable) -->
            <IconTabFilter
              key="tree"
              text="{i18n>tabTrTree}"
              icon="sap-icon://tree">
              <content>
                <VBox height="100%" fitContainer="true">
                  <Toolbar>
                    <Title text="{i18n>tabTrTree}" />
                    <ToolbarSpacer />
                    <BusyIndicator size="1rem" visible="{trSearch>/loadingMoreTree}" class="sapUiTinyMarginEnd" />
                    <Label text="{= ${trSearch>/countTree} ? (${trSearch>/countTree} + ' node(s)') : ''}" class="sapUiTinyMarginEnd" />
                    <Button icon="sap-icon://collapse-all" tooltip="{i18n>collapseAll}"
                      press=".onCollapseAll" type="Transparent" />
                    <Button icon="sap-icon://expand-all" tooltip="{i18n>expandAll}"
                      press=".onExpandAll" type="Transparent" />
                    <Button icon="sap-icon://refresh" tooltip="Reload"
                      press=".onSearch" type="Transparent" />
                  </Toolbar>

                  <!-- Native UI5 TreeTable for expand/collapse hierarchy -->
                  <table:TreeTable
                    id="trTreeTable"
                    busy="{trSearch>/busyTree}"
                    rowHeight="36"
                    columnHeaderHeight="36"
                    enableColumnReordering="true"
                    showColumnVisibilityMenu="true"
                    selectionMode="Single"
                    rowSelectionChange=".onTreeRowSelect"
                    expandFirstLevel="true"
                    useGroupMode="false"
                    visibleRowCountMode="Auto"
                    minAutoRowCount="5"
                    threshold="50"
                    filter=".onTreeTableFilter">
                    <table:layoutData>
                      <FlexItemData growFactor="1" />
                    </table:layoutData>

                    <table:columns>
                      <table:Column width="26rem" filterProperty="ObjName" sortProperty="Trkorr">
                        <Label text="{i18n>colTrTaskObj}" />
                        <table:template>
                          <HBox alignItems="Center">
                            <core:Icon
                              src="{path:'trTree>NodeType', formatter:'.formatNodeIcon'}"
                              class="sapUiTinyMarginEnd"
                              color="{path:'trTree>NodeType', formatter:'.formatNodeColor'}" />
                            <!-- Show tick if Released, else nothing -->
                            <core:Icon 
                              src="sap-icon://sys-enter-2" 
                              color="Positive" 
                              class="sapUiTinyMarginEnd" 
                              tooltip="Released"
                              visible="{= ${trTree>TrStatus} === 'R' }" />
                            
                            <ObjectIdentifier
                              title="{= ${trTree>NodeType} === 'OBJ' || ${trTree>NodeType} === 'ATTR' || ${trTree>NodeType} === 'COMM' ? ${trTree>ObjName} : (${trTree>NodeType} === 'FOLD' ? (${trTree>Description} || ${trTree>ObjName} || ${trTree>ObjType}) : ${trTree>Trkorr}) }"
                              titleActive="{= ${trTree>NodeType} === 'OBJ' }"
                              titlePress=".onTreeObjNamePress" />
                          </HBox>
                        </table:template>
                      </table:Column>

                      <table:Column width="8rem" filterProperty="ObjType" sortProperty="ObjType">
                        <Label text="{i18n>colType}" />
                        <table:template>
                          <Text text="{= ${trTree>NodeType} === 'OBJ' ? ${trTree>ObjType} : (${trTree>NodeType} === 'FOLD' || ${trTree>NodeType} === 'ATTR' || ${trTree>NodeType} === 'COMM' ? '' : ${trTree>NodeType}) }" />
                        </table:template>
                      </table:Column>

                      <table:Column width="10rem" filterProperty="Owner" sortProperty="Owner">
                        <Label text="{i18n>ownerFilter}" />
                        <table:template>
                          <Text text="{trTree>Owner}" />
                        </table:template>
                      </table:Column>

                      <table:Column width="auto" filterProperty="Description" sortProperty="Description">
                        <Label text="{i18n>colDescription}" />
                        <table:template>
                          <Text text="{= ${trTree>NodeType} === 'FOLD' ? '' : ${trTree>Description} }" wrapping="false" />
                        </table:template>
                      </table:Column>

                      <table:Column width="16.5rem">
                        <Label text="{i18n>colActions}" />
                        <table:template>
                          <HBox>
                            <!-- TR Details button (Always available for TR / Task) -->
                            <Button
                              icon="sap-icon://hint"
                              tooltip="View TR Details &amp; Objects"
                              type="Transparent"
                              visible="{= ${trTree>NodeType} === 'TR' || ${trTree>NodeType} === 'TASK' }"
                              press=".onTreeOpenDetail" />
                            <!-- Release button for Unreleased TR/Task -->
                            <Button
                              text="{i18n>btnRelease}"
                              icon="sap-icon://shipping-status"
                              tooltip="{i18n>btnReleaseTR}"
                              type="Emphasized"
                              visible="{= (${trTree>NodeType} === 'TR' || ${trTree>NodeType} === 'TASK') &amp;&amp; ${trTree>TrStatus} !== 'R' }"
                              press=".onTreeReleasePress" />
                            <!-- Apply button for Released TR -->
                            <Button
                              text="{i18n>btnApply}"
                              icon="sap-icon://upload-to-cloud"
                              tooltip="{i18n>btnApplyTarget}"
                              type="Accept"
                              visible="{= ${trTree>NodeType} === 'TR' &amp;&amp; ${trTree>TrStatus} === 'R' }"
                              press=".onTreeOpenDetail" />
                            <!-- Compare Code button for Object node -->
                            <Button
                              text="{i18n>btnCompare}"
                              icon="sap-icon://compare-2"
                              tooltip="{i18n>openCompareTooltip}"
                              type="Default"
                              visible="{= ${trTree>NodeType} === 'OBJ' }"
                              press=".onTreeObjCompare"
                              class="sapUiTinyMarginEnd" />
                            <!-- View Source / Metadata for Object node -->
                            <Button
                              icon="sap-icon://document-text"
                              tooltip="{i18n>viewSourceTooltip}"
                              type="Transparent"
                              visible="{= ${trTree>NodeType} === 'OBJ' }"
                              press=".onTreeObjViewSource" />
                            <!-- Find in Object Search for Object node -->
                            <Button
                              icon="sap-icon://search"
                              tooltip="{i18n>btnFindInObjSearch}"
                              type="Transparent"
                              visible="{= ${trTree>NodeType} === 'OBJ' }"
                              press=".onTreeFindInObjSearch" />
                          </HBox>
                        </table:template>
                      </table:Column>
                    </table:columns>

                  </table:TreeTable>
                </VBox>
              </content>
            </IconTabFilter>

            <!-- TAB 2: TR Flat List (sap.ui.table.Table) -->
            <IconTabFilter
              key="flat"
              text="{i18n>tabFlatList}"
              icon="sap-icon://table-view"
              count="{trSearch>/countFlat}">
              <content>
                <VBox height="100%" fitContainer="true">
                  <OverflowToolbar>
                    <Title text="{i18n>tabFlatList}" />
                    <ToolbarSpacer />
                    <BusyIndicator size="1rem" visible="{trSearch>/loadingMoreFlat}" class="sapUiTinyMarginEnd" />
                    <Label text="{= ${trSearch>/countFlat} + ' object(s)'}" class="sapUiTinyMarginEnd" />
                    <Button icon="sap-icon://action-settings" tooltip="{i18n>btnTableSettings}" press=".onOpenFlatTableSettings" type="Transparent" />
                    <Button icon="sap-icon://refresh" tooltip="{i18n>btnResetLayout}" press=".onResetFlatTableLayout" type="Transparent" />
                    <Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onExportFlat" type="Transparent" />
                  </OverflowToolbar>

                  <table:Table id="tblFlat"
                    rows="{path: 'trSearch>/flatRows'}"
                    busy="{trSearch>/busyFlat}"
                    noData="{i18n>noData}"
                    selectionMode="Single"
                    rowSelectionChange=".onFlatRowSelect"
                    firstVisibleRowChanged=".onFlatTableScroll"
                    threshold="50"
                    alternateRowColors="true"
                    enableColumnReordering="true"
                    showColumnVisibilityMenu="true"
                    visibleRowCountMode="Auto"
                    minAutoRowCount="5"
                    rowHeight="36"
                    columnHeaderHeight="36">
                    <table:layoutData>
                      <FlexItemData growFactor="1" />
                    </table:layoutData>
                    <table:columns>
                      <table:Column id="colFlatTrkorr" width="10rem" filterProperty="Trkorr" sortProperty="Trkorr" visible="{tableSettings>/showTrkorr}">
                        <Label text="{i18n>trkorr}" />
                        <table:template>
                          <Link text="{trSearch>Trkorr}" press=".onFlatOpenDetail" />
                        </table:template>
                      </table:Column>

                      <table:Column id="colFlatManagingTr" width="12rem" filterProperty="CurrentManagingTr" sortProperty="CurrentManagingTr" visible="{tableSettings>/showManagingTr}">
                        <Label text="{i18n>currentManagingTr}" />
                        <table:template>
                          <Link
                            text="{trSearch>CurrentManagingTr}"
                            press=".onFlatOpenManagingTrDetail" />
                        </table:template>
                      </table:Column>

                      <table:Column id="colFlatType" width="6rem" filterProperty="ObjectType" sortProperty="ObjectType" visible="{tableSettings>/showType}">
                        <Label text="{i18n>colType}" />
                        <table:template>
                          <ObjectStatus text="{trSearch>ObjectType}" state="None" />
                        </table:template>
                      </table:Column>

                      <table:Column id="colFlatName" width="18rem" filterProperty="ObjectName" sortProperty="ObjectName" visible="{tableSettings>/showName}">
                        <Label text="{i18n>colObjName}" />
                        <table:template>
                          <ObjectIdentifier
                            title="{trSearch>ObjectName}"
                            titleActive="true"
                            titlePress=".onFlatObjNamePress" />
                        </table:template>
                      </table:Column>

                      <table:Column id="colFlatPackage" width="10rem" filterProperty="PackageName" sortProperty="PackageName" visible="{tableSettings>/showPackage}">
                        <Label text="{i18n>colPackage}" />
                        <table:template>
                          <Text text="{trSearch>PackageName}" />
                        </table:template>
                      </table:Column>

                      <table:Column id="colFlatOwner" width="9rem" filterProperty="Owner" sortProperty="Owner" visible="{tableSettings>/showOwner}">
                        <Label text="{i18n>ownerFilter}" />
                        <table:template>
                          <Text text="{trSearch>Owner}" />
                        </table:template>
                      </table:Column>

                      <table:Column id="colFlatStatus" width="8.5rem" filterProperty="TrStatus" sortProperty="TrStatus" visible="{tableSettings>/showStatus}">
                        <Label text="{i18n>colTrStatus}" />
                        <table:template>
                          <ObjectStatus
                            text="{path:'trSearch>TrStatus', formatter:'.formatTrStatusText'}"
                            state="{path:'trSearch>TrStatus', formatter:'.formatTrStatus'}" />
                        </table:template>
                      </table:Column>

                      <table:Column id="colFlatObjStatus" width="9rem" filterProperty="ObjectStatus" sortProperty="ObjectStatus" visible="{tableSettings>/showObjStatus}">
                        <Label text="{i18n>colObjStatus}" />
                        <table:template>
                          <ObjectStatus
                            text="{parts: [{path: 'trSearch>ObjectStatus'}, {path: 'trSearch>Activity'}], formatter: '.formatObjStatusText'}"
                            state="{parts: [{path: 'trSearch>ObjectStatus'}, {path: 'trSearch>Activity'}], formatter: '.formatObjStatusState'}"
                            icon="{parts: [{path: 'trSearch>ObjectStatus'}, {path: 'trSearch>Activity'}], formatter: '.formatObjStatusIcon'}" />
                        </table:template>
                      </table:Column>

                      <table:Column id="colFlatActions" width="11.5rem">
                        <Label text="{i18n>colActions}" />
                        <table:template>
                          <HBox>
                            <Button icon="sap-icon://detail-view"
                              tooltip="Open TR Detail (Release / Apply)"
                              type="Transparent"
                              press=".onFlatOpenDetail" />
                            <Button icon="sap-icon://compare-2"
                              tooltip="{i18n>openCompareTooltip}"
                              type="Transparent"
                              press=".onFlatObjCompare" />
                            <Button icon="sap-icon://document-text"
                              tooltip="{i18n>viewSourceTooltip}"
                              type="Transparent"
                              press=".onFlatObjViewSource" />
                            <Button icon="sap-icon://search"
                              tooltip="{i18n>btnFindInObjSearch}"
                              type="Transparent"
                              press=".onFlatFindInObjSearch" />
                          </HBox>
                        </table:template>
                      </table:Column>
                    </table:columns>
                  </table:Table>
                </VBox>
              </content>
            </IconTabFilter>

          </items>
        </IconTabBar>

      </VBox>
    </content>
  </Page>

</mvc:View>
