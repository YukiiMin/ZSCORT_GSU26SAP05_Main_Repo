<mvc:View
  controllerName="zscort.app.controller.Master"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc">

  <Page id="idMasterPage" title="Transport Requests" showHeader="true" backgroundDesign="List">

    <customHeader>
      <Bar>
        <contentLeft>
          <Button
            icon="sap-icon://nav-back"
            text="Object Search"
            type="Transparent"
            press=".onNavObjSearch"
            tooltip="Back to Object Search" />
          <Title text="Code Compare — TR List" class="sapUiTinyMarginBegin" />
        </contentLeft>
        <contentRight>
          <Button icon="sap-icon://home" type="Transparent" press=".onNavObjSearch" tooltip="Home — Object Search" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <VBox height="100%">
        <MessageStrip
          text="Released TRs only."
          type="Information"
          showIcon="true"
          class="sapUiSmallMargin" />

        <SearchField
          id="idSearchField"
          placeholder="Search released TR (e.g. S40K*)..."
          search=".onSearchFieldSearch"
          width="100%"
          class="sapUiSmallMargin" />

        <List
          id="idVHTrkorrList"
          mode="SingleSelectMaster"
          busy="{master>/busy}"
          noDataText="{= ${master>/message} || 'No released TR' }"
          selectionChange=".onVHTrkorrListSelectionChange"
          items="{path: 'master>/rows'}"
          growing="true"
          growingScrollToLoad="true">

          <items>
            <ObjectListItem
              title="{master>Trkorr}"
              type="Navigation"
              press=".onObjectListItemPress"
              intro="{master>Description}">
              <firstStatus>
                <ObjectStatus text="Released" state="Success" />
              </firstStatus>
              <attributes>
                <ObjectAttribute text="{= ${ddic>/ZCE_SCORT_TR_VH/As4user} || 'Owner' }: {master>As4user}" />
                <ObjectAttribute text="{= ${ddic>/ZCE_SCORT_TR_VH/As4date} || 'Created' }: {path: 'master>As4date', formatter: '.formatDate'}" />
              </attributes>
            </ObjectListItem>
          </items>
        </List>
      </VBox>
    </content>
  </Page>

</mvc:View>
