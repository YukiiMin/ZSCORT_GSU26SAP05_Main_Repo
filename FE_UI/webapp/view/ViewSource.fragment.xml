<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns:table="sap.ui.table"
  xmlns:layout="sap.ui.layout">
  <Dialog
    id="idViewSourceDialog"
    title="{i18n>viewSourceTitle}: {appView>/viewSourceType} {appView>/viewSourceName} — [{= ${appView>/viewSourceServer} === 'T' ? ${i18n>tabTarget} : ${i18n>tabLocal} }]"
    contentWidth="88vw"
    contentHeight="85vh"
    resizable="true"
    draggable="true"
    afterOpen=".onDialogViewSourceAfterOpen"
    afterClose=".onDialogViewSourceAfterClose">

    <customHeader>
      <Toolbar>
        <Title text="{i18n>viewSourceTitle}: {appView>/viewSourceType} {appView>/viewSourceName}" />
        <ToolbarSpacer />
        <ObjectStatus
          text="{= ${appView>/viewSourceServer} === 'T' ? ${i18n>tabTarget} : ${i18n>tabLocal} }"
          state="{= ${appView>/viewSourceServer} === 'T' ? 'Information' : 'Success' }"
          class="sapUiTinyMarginEnd" />
        <ObjectStatus text="{appView>/viewSourceMessage}" state="{= ${appView>/viewSourceHash} ? 'Success' : (${appView>/viewSourceMessage} === 'LOCAL_ONLY' || ${appView>/viewSourceMessage} === 'Not available in Target (LOCAL_ONLY)' ? 'Warning' : (${appView>/viewSourceMessage} === 'NOT_SUPPORTED' ? 'Information' : 'Error'))}" class="sapUiTinyMarginEnd" />
        <Button
          icon="sap-icon://ai"
          text="{i18n>btnAiReview}"
          type="{= ${appView>/showSourceAiPanel} ? 'Emphasized' : 'Default' }"
          press=".onToggleSourceAiPanel"
          tooltip="{i18n>btnAiReviewTooltip}"
          class="sapUiTinyMarginEnd" />
        <Button icon="sap-icon://copy" press=".onButtonCopySourcePress" tooltip="{i18n>btnCopySource}" type="Transparent" />
        <Button icon="sap-icon://decline" press=".onButtonCloseDialogPress" tooltip="{i18n>btnClose}" type="Transparent" />
      </Toolbar>
    </customHeader>
    <content>
      <IconTabBar id="idViewSourceIconTabBar" class="sapUiNoContentPadding" stretchContentHeight="true" select=".onDialogViewSourceTabSelect">
        <items>
          <IconTabFilter
            id="idViewSourceAdtFormFilter"
            key="adtForm"
            text="{= ${appView>/viewSourceType} === 'MSAG' ? 'Messages' : (${appView>/viewSourceType} === 'DEVC' ? 'Package Details' : (${appView>/viewSourceType} === 'TTYP' ? 'Table Type Details' : 'ADT Definition')) }"
            icon="{= ${appView>/viewSourceType} === 'MSAG' ? 'sap-icon://message-popup' : (${appView>/viewSourceType} === 'DEVC' ? 'sap-icon://folder' : (${appView>/viewSourceType} === 'TTYP' ? 'sap-icon://table-column' : 'sap-icon://form')) }"
            visible="{= ${appView>/viewSourceType} === 'DOMA' || ${appView>/viewSourceType} === 'DTEL' || ${appView>/viewSourceType} === 'MSAG' || ${appView>/viewSourceType} === 'DEVC' || ${appView>/viewSourceType} === 'TTYP' }">
            <ScrollContainer height="100%" vertical="true">
              <VBox visible="{= ${appView>/viewSourceType} === 'DOMA' }">
                <core:Fragment fragmentName="zscort.app.view.fragment.DomainForm" type="XML" />
              </VBox>
              <VBox visible="{= ${appView>/viewSourceType} === 'DTEL' }">
                <core:Fragment fragmentName="zscort.app.view.fragment.DataElementForm" type="XML" />
              </VBox>
              <VBox visible="{= ${appView>/viewSourceType} === 'MSAG' }">
                <core:Fragment fragmentName="zscort.app.view.fragment.MessageClassForm" type="XML" />
              </VBox>
              <VBox visible="{= ${appView>/viewSourceType} === 'DEVC' }">
                <core:Fragment fragmentName="zscort.app.view.fragment.PackageForm" type="XML" />
              </VBox>
              <VBox visible="{= ${appView>/viewSourceType} === 'TTYP' }">
                <core:Fragment fragmentName="zscort.app.view.fragment.TableTypeForm" type="XML" />
              </VBox>
            </ScrollContainer>
          </IconTabFilter>
          <IconTabFilter key="source" text="{i18n>tabSourceCode}" icon="sap-icon://document-text">
            <layout:Splitter height="100%" width="100%">
              <!-- Left: Monaco Code Editor or Not Supported Notice -->
              <VBox height="100%" class="sapUiNoContentPadding" fitContainer="true">
                <layoutData>
                  <layout:SplitterLayoutData size="{= ${appView>/showSourceAiPanel} ? '65%' : '100%' }" />
                </layoutData>
                <VBox visible="{= ${appView>/viewSourceMessage} === 'NOT_SUPPORTED' }" class="sapUiMediumMargin" alignItems="Center" justifyContent="Center" height="100%">
                  <IllustratedMessage
                    illustrationType="sapIllus-NoData"
                    title="Source Code Not Supported"
                    description="Source code / ADT detail view is not supported for {appView>/viewSourceType} (requires SAP GUI in ADT Eclipse). Please see the Metadata tab." />
                </VBox>
                <VBox visible="{= ${appView>/viewSourceMessage} !== 'NOT_SUPPORTED' }" height="100%" class="sapUiNoContentPadding" fitContainer="true">
                  <core:HTML
                    preferDOM="true"
                    content='&lt;div class=&quot;codeHost&quot; style=&quot;width:100%;height:100%;min-height:50vh;&quot;&gt;&lt;/div&gt;' />
                </VBox>
              </VBox>

              <!-- Right: AI Review Side Panel -->
              <VBox height="100%" visible="{appView>/showSourceAiPanel}" fitContainer="true" class="sapUiNoContentPadding">
                <layoutData>
                  <layout:SplitterLayoutData size="{= ${appView>/showSourceAiPanel} ? '35%' : '0%' }" resizable="true" />
                </layoutData>
                <core:Fragment id="idSourceAiFrag" fragmentName="zscort.app.view.AiSidePanel" type="XML" />
              </VBox>
            </layout:Splitter>
          </IconTabFilter>

          <!-- TAB: Table Data Preview (for TABL) -->
          <IconTabFilter
            id="idViewSourceTableDataFilter"
            key="tableData"
            text="Table Data"
            icon="sap-icon://table-view"
            visible="{= ${appView>/viewSourceType} === 'TABL' }">
            <VBox height="100%" width="100%" class="sapUiNoContentPadding">
              <OverflowToolbar>
                <Title text="Data Preview" level="H5" />
                <ObjectStatus text="{appView>/viewSourceTableCountText}" state="Information" class="sapUiSmallMarginBegin" />
                <ToolbarSpacer />
                <SearchField id="idViewSourceTableSearch" width="16rem" placeholder="Search in data..." liveChange=".onViewSourceTableLiveSearch" />
              </OverflowToolbar>
              <ScrollContainer height="100%" width="100%" horizontal="true" vertical="true">
                <table:Table
                  id="idViewSourceDataTable"
                  selectionMode="None"
                  visibleRowCountMode="Auto"
                  minAutoRowCount="10"
                  class="sapUiSizeCompact" />
              </ScrollContainer>
            </VBox>
          </IconTabFilter>
          <IconTabFilter key="metadata" text="{i18n>tabMetadata}" icon="sap-icon://tag">
            <VBox height="100%" class="sapUiMediumMargin">
              <f:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsL="1" columnsM="1">
                <f:content>
                  <Label text="{i18n>lblServerLocation}" />
                  <ObjectStatus
                    text="{= ${appView>/viewSourceServer} === 'T' ? ${i18n>lblTargetSnapshotServer} : ${i18n>lblLocalActiveServer} }"
                    state="{= ${appView>/viewSourceServer} === 'T' ? 'Information' : 'Success' }" />

                  <Label text="{i18n>colType}" />
                  <Text text="{appView>/viewSourceType}" />
                  
                  <Label text="{i18n>colObjName}" />
                  <Text text="{appView>/viewSourceName}" />

                  <Label text="{i18n>colStatus}" visible="{= !!${appView>/viewSourceMetaData/ExistenceStatus} }" />
                  <ObjectStatus
                    visible="{= !!${appView>/viewSourceMetaData/ExistenceStatus} }"
                    text="{appView>/viewSourceMetaData/ExistenceStatus}"
                    state="{path:'appView>/viewSourceMetaData/ExistenceStatus', formatter:'.formatExistenceState'}" />

                  <Label text="{i18n>colPackage}" />
                  <Text text="{= (${appView>/viewSourceServer} === 'T' ? (${appView>/viewSourceMetaData/TargetPackage} || ${appView>/viewSourceMetaData/PackageName}) : (${appView>/viewSourceMetaData/LocalPackage} || ${appView>/viewSourceMetaData/PackageName} || ${appView>/viewSourceMetaData/TadirDevclass})) || 'N/A'}" />
                  
                  <Label text="{i18n>authorLabel}" />
                  <Text text="{= (${appView>/viewSourceServer} === 'T' ? (${appView>/viewSourceMetaData/TargetAuthor} || ${appView>/viewSourceMetaData/PersonResponsible} || ${appView>/viewSourceMetaData/Author}) : (${appView>/viewSourceMetaData/LocalAuthor} || ${appView>/viewSourceMetaData/PersonResponsible} || ${appView>/viewSourceMetaData/Owner} || ${appView>/viewSourceMetaData/Author})) || 'N/A'}" />
                  
                  <Label text="{i18n>colCreated}" />
                  <Text text="{path:'appView>/viewSourceMetaData/CreatedOn', formatter:'.formatDate'} {= ${appView>/viewSourceMetaData/CreatedOn} ? '' : (${appView>/viewSourceMetaData/As4date} ? ${path:'appView>/viewSourceMetaData/As4date', formatter:'.formatDate'} : 'N/A')}" />
                </f:content>
              </f:SimpleForm>
            </VBox>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </content>

  </Dialog>
</core:FragmentDefinition>
