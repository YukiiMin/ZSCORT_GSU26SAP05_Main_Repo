<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    id="idViewSourceDialog"
    title="Source Code: {appView>/viewSourceType} {appView>/viewSourceName} ({appView>/viewSourceServer})"
    contentWidth="80vw"
    contentHeight="80vh"
    resizable="true"
    draggable="true"
    afterOpen=".onDialogViewSourceAfterOpen"
    afterClose=".onDialogViewSourceAfterClose">

    <customHeader>
      <Toolbar>
        <Title text="Source Code" />
        <ToolbarSpacer />
        <ObjectStatus text="{appView>/viewSourceMessage}" state="{= ${appView>/viewSourceHash} ? 'Success' : 'Error'}" class="sapUiTinyMarginEnd" />
        <Button icon="sap-icon://copy" press=".onButtonCopySourcePress" tooltip="Copy to Clipboard" type="Transparent" />
        <Button icon="sap-icon://decline" press=".onButtonCloseDialogPress" type="Transparent" />
      </Toolbar>
    </customHeader>

    <content>
      <VBox height="100%" class="sapUiNoContentPadding" fitContainer="true">
        <core:HTML
          preferDOM="true"
          content='&lt;div class=&quot;codeHost&quot; style=&quot;width:100%;height:60vh;min-height:60vh;&quot;&gt;&lt;/div&gt;' />
      </VBox>
    </content>

  </Dialog>
</core:FragmentDefinition>
